58,"text":"    }"},{"sha":"927b2a4df0f75962d1687371f2db1ee9db0a415a","author":"matemolnar8","timestamp":1776924856,"line":259,"text":"}"},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":260,"text":""},{"sha":"927b2a4df0f75962d1687371f2db1ee9db0a415a","author":"matemolnar8","timestamp":1776924856,"line":261,"text":"impl input::OverlayIntentSink for OverlayInputSink {"},{"sha":"927b2a4df0f75962d1687371f2db1ee9db0a415a","author":"matemolnar8","timestamp":1776924856,"line":262,"text":"    fn handle(&mut self, intent: input::OverlayIntent) -> input::IntentResult {"},{"sha":"7fe87ba2159132f09ca8501774c3e6c3bc1fa2d4","author":"matemolnar8","timestamp":1783546068,"line":263,"text":"        let bounds = self.view.bounds();"},{"sha":"7fe87ba2159132f09ca8501774c3e6c3bc1fa2d4","author":"matemolnar8","timestamp":1783546068,"line":264,"text":"        with_session_mut(|session| session.handle(intent, bounds))"},{"sha":"7fe87ba2159132f09ca8501774c3e6c3bc1fa2d4","author":"matemolnar8","timestamp":1783546068,"line":265,"text":"            .map(|outcome| self.apply_outcome(outcome))"},{"sha":"7fe87ba2159132f09ca8501774c3e6c3bc1fa2d4","author":"matemolnar8","timestamp":1783546068,"line":266,"text":"            .unwrap_or(input::IntentResult::PassThrough)"},{"sha":"927b2a4df0f75962d1687371f2db1ee9db0a415a","author":"matemolnar8","timestamp":1776924856,"line":267,"text":"    }"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":268,"text":"}"}]}
