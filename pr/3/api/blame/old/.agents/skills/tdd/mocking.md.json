{"path":".agents/skills/tdd/mocking.md","ref":"2c167c094b21500cfcbf4733064d83f6a69dc4f7","side":"old","lines":[{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":1,"text":"# When to Mock"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":2,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":3,"text":"Mock at **system boundaries** only:"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":4,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":5,"text":"- External APIs (payment, email, etc.)"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":6,"text":"- Databases (sometimes - prefer test DB)"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":7,"text":"- Time/randomness"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":8,"text":"- File system (sometimes)"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":9,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":10,"text":"Don't mock:"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":11,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":12,"text":"- Your own classes/modules"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":13,"text":"- Internal collaborators"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":14,"text":"- Anything you control"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":15,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":16,"text":"## Designing for Mockability"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":17,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":18,"text":"At system boundaries, design interfaces that are easy to mock:"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":19,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":20,"text":"**1. Use dependency injection**"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":21,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":22,"text":"Pass external dependencies in rather than creating them internally:"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":23,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":24,"text":"```typescript"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":25,"text":"// Easy to mock"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":26,"text":"function processPayment(order, paymentClient) {"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":27,"text":"  return paymentClient.charge(order.total);"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":28,"text":"}"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":29,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":30,"text":"// Hard to mock"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":31,"text":"function processPayment(order) {"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":32,"text":"  const client = new StripeClient(process.env.STRIPE_KEY);"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":33,"text":"  return client.charge(order.total);"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":34,"text":"}"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":35,"text":"```"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":36,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":37,"text":"**2. Prefer SDK-style interfaces over generic fetchers**"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":38,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":39,"text":"Create specific functions for each external operation instead of one generic function with conditional logic:"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":40,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":41,"text":"```typescript"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":42,"text":"// GOOD: Each function is independently mockable"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":43,"text":"const api = {"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":44,"text":"  getUser: (id) => fetch(`/users/${id}`),"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":45,"text":"  getOrders: (userId) => fetch(`/users/${userId}/orders`),"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":46,"text":"  createOrder: (data) => fetch('/orders', { method: 'POST', body: data }),"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":47,"text":"};"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":48,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":49,"text":"// BAD: Mocking requires conditional logic inside the mock"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":50,"text":"const api = {"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":51,"text":"  fetch: (endpoint, options) => fetch(endpoint, options),"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":52,"text":"};"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":53,"text":"```"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":54,"text":""},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":55,"text":"The SDK approach means:"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":56,"text":"- Each mock returns one specific shape"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":57,"text":"- No conditional logic in test setup"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":58,"text":"- Easier to see which endpoints a test exercises"},{"sha":"2a2d7910207a4ef9a7d29c77f8ba2e904a638be0","author":"matemolnar8","timestamp":1783544569,"line":59,"text":"- Type safety per endpoint"}]}
