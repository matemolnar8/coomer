            unsafe {"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":27,"text":"                        ::libc::kill(pid, ::libc::SIGTERM);"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":28,"text":"                    }"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":29,"text":"                    std::thread::sleep(std::time::Duration::from_millis(120));"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":30,"text":"                }"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":31,"text":"            }"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":32,"text":"        }"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":33,"text":"        let _ = std::fs::remove_file(&pidfile);"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":34,"text":"    }"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":35,"text":"    std::fs::write(&pidfile, format!(\"{}\\n\", std::process::id())).map_err(|e| e.to_string())?;"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":36,"text":"    Ok(())"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":37,"text":"}"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":38,"text":""},{"sha":"b94c8c6e3178c746f168e2d0ed611719bf75c323","author":"matemolnar8","timestamp":1776662826,"line":39,"text":"pub(crate) fn cleanup_pidfile() {"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":40,"text":"    if let Ok(dir) = coomer_data_dir() {"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":41,"text":"        let _ = std::fs::remove_file(dir.join(\"pid\"));"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":42,"text":"    }"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":43,"text":"}"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":44,"text":""},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":45,"text":"pub fn run() -> Result<(), String> {"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":46,"text":"    replace_running_instance()?;"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":47,"text":""},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":48,"text":"    let mtm = MainThreadMarker::new().ok_or(\"coomer must run on the main thread\")?;"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":49,"text":""},{"sha":"b94c8c6e3178c746f168e2d0ed611719bf75c323","author":"matemolnar8","timestamp":1776662826,"line":50,"text":"    let app = NSApplication::sharedApplication(mtm);"},{"sha":"b94c8c6e3178c746f168e2d0ed611719bf75c323","author":"matemolnar8","timestamp":1776662826,"line":51,"text":"    app.setActivationPolicy(objc2_app_kit::NSApplicationActivationPolicy::Accessory);"},{"sha":"b94c8c6e3178c746f168e2d0ed611719bf75c323","author":"matemolnar8","timestamp":1776662826,"line":52,"text":"    permissions::ensure_screen_capture_access(mtm, &app);"},{"sha":"b94c8c6e3178c746f168e2d0ed611719bf75c323","author":"matemolnar8","timestamp":1776662826,"line":53,"text":""},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":54,"text":"    let cap = capture::capture_under_cursor(mtm)?;"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":55,"text":"    let mouse = objc2_app_kit::NSEvent::mouseLocation();"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":56,"text":"    let (window, view) = overlay::spawn_window(mtm, &cap.screen, cap.window_frame)?;"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":57,"text":""},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":58,"text":"    {"},{"sha":"d69b1a6805688d6948097a3e2d2223a3bea3cf15","author":"matemolnar8","timestamp":1776925805,"line":59,"text":"        let wp = window.convertPointFromScreen(mouse);"},{"sha":"d69b1a6805688d6948097a3e2d2223a3bea3cf15","author":"matemolnar8","timestamp":1776925805,"line":60,"text":"        let vp = view.convertPoint_fromView(wp, None);"},{"sha":"7fe87ba2159132f09ca8501774c3e6c3bc1fa2d4","author":"matemolnar8","timestamp":1783546068,"line":61,"text":"        overlay::start_session(OverlaySession::new(cap.cg_image, vp));"},{"sha":"8c154eadd7d8e8172fb9e631a8c147401a9f99f7","author":"matemolnar8","timestamp":1777106278,"line":62,"text":"        overlay::refresh_hud_visibility();"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":63,"text":"    }"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":64,"text":""},{"sha":"927b2a4df0f75962d1687371f2db1ee9db0a415a","author":"matemolnar8","timestamp":1776924856,"line":65,"text":"    let view_ns = overlay::retained_content_ns_view(&view);"},{"sha":"927b2a4df0f75962d1687371f2db1ee9db0a415a","author":"matemolnar8","timestamp":1776924856,"line":66,"text":"    let sink = OverlayInputSink::new(mtm, window.clone(), view.clone());"},{"sha":"927b2a4df0f75962d1687371f2db1ee9db0a415a","author":"matemolnar8","timestamp":1776924856,"line":67,"text":"    let _monitor = input::install_overlay_monitor(mtm, view_ns, sink);"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":68,"text":""},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":69,"text":"    #[allow(deprecated)]"},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":70,"text":"    {"},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":71,"text":"        app.activateIgnoringOtherApps(true);"},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":72,"text":"    }"},{"sha":"d69b1a6805688d6948097a3e2d2223a3bea3cf15","author":"matemolnar8","timestamp":1776925805,"line":73,"text":"    window.makeKeyAndOrderFront(None);"},{"sha":"d69b1a6805688d6948097a3e2d2223a3bea3cf15","author":"matemolnar8","timestamp":1776925805,"line":74,"text":"    let _ = window.makeFirstResponder(Some(&*view));"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":75,"text":"    view.setNeedsDisplay(true);"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":76,"text":""},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":77,"text":"    app.run();"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":78,"text":""},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":79,"text":"    overlay::clear_session();"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":80,"text":"    cleanup_pidfile();"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":81,"text":"    Ok(())"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":82,"text":"}"}]}
