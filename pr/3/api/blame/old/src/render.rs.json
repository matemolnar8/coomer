698,"line":13,"text":""},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":14,"text":"pub fn draw_session("},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":15,"text":"    cg_ctx: &CGContext,"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":16,"text":"    view_bounds: NSRect,"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":17,"text":"    image: &SysCgImage,"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":18,"text":"    zoom: f64,"},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":19,"text":"    pointer: CGPoint,"},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":20,"text":"    image_origin: CGPoint,"},{"sha":"ea7508c068a2a0174250945d1aeb9bf55da94f58","author":"matemolnar8","timestamp":1776625714,"line":21,"text":"    flashlight_progress: f64,"},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":22,"text":"    flashlight_radius: f64,"},{"sha":"78dba3427a1c4ff2c3f1bdc14fb04700473b37d0","author":"matemolnar8","timestamp":1776633339,"line":23,"text":"    fade_in_progress: f64,"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":24,"text":") {"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":25,"text":"    let bounds = nsrect_to_cgrect(view_bounds);"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":26,"text":"    let objc_img: &CGImage = unsafe { &*(ForeignType::as_ptr(image).cast::<CGImage>()) };"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":27,"text":"    let c = Some(cg_ctx);"},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":28,"text":"    let scaled = CGRect::new("},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":29,"text":"        CGPoint::new(image_origin.x as CGFloat, image_origin.y as CGFloat),"},{"sha":"ea7508c068a2a0174250945d1aeb9bf55da94f58","author":"matemolnar8","timestamp":1776625714,"line":30,"text":"        CGSize::new("},{"sha":"ea7508c068a2a0174250945d1aeb9bf55da94f58","author":"matemolnar8","timestamp":1776625714,"line":31,"text":"            bounds.size.width * zoom as CGFloat,"},{"sha":"ea7508c068a2a0174250945d1aeb9bf55da94f58","author":"matemolnar8","timestamp":1776625714,"line":32,"text":"            bounds.size.height * zoom as CGFloat,"},{"sha":"ea7508c068a2a0174250945d1aeb9bf55da94f58","author":"matemolnar8","timestamp":1776625714,"line":33,"text":"        ),"},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":34,"text":"    );"},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":35,"text":"    CGContext::draw_image(c, scaled, Some(objc_img));"},{"sha":"78dba3427a1c4ff2c3f1bdc14fb04700473b37d0","author":"matemolnar8","timestamp":1776633339,"line":36,"text":""},{"sha":"78dba3427a1c4ff2c3f1bdc14fb04700473b37d0","author":"matemolnar8","timestamp":1776633339,"line":37,"text":"    let fade_progress = fade_in_progress.clamp(0.0, 1.0) as CGFloat;"},{"sha":"78dba3427a1c4ff2c3f1bdc14fb04700473b37d0","author":"matemolnar8","timestamp":1776633339,"line":38,"text":"    if fade_progress > 0.0 {"},{"sha":"78dba3427a1c4ff2c3f1bdc14fb04700473b37d0","author":"matemolnar8","timestamp":1776633339,"line":39,"text":"        CGContext::set_rgb_fill_color(c, 1.0, 1.0, 1.0, 0.3 * (1.0 - fade_progress));"},{"sha":"78dba3427a1c4ff2c3f1bdc14fb04700473b37d0","author":"matemolnar8","timestamp":1776633339,"line":40,"text":"        CGContext::begin_path(c);"},{"sha":"78dba3427a1c4ff2c3f1bdc14fb04700473b37d0","author":"matemolnar8","timestamp":1776633339,"line":41,"text":"        CGContext::add_rect(c, bounds);"},{"sha":"78dba3427a1c4ff2c3f1bdc14fb04700473b37d0","author":"matemolnar8","timestamp":1776633339,"line":42,"text":"        CGContext::fill_path(c);"},{"sha":"78dba3427a1c4ff2c3f1bdc14fb04700473b37d0","author":"matemolnar8","timestamp":1776633339,"line":43,"text":"    }"},{"sha":"78dba3427a1c4ff2c3f1bdc14fb04700473b37d0","author":"matemolnar8","timestamp":1776633339,"line":44,"text":""},{"sha":"ea7508c068a2a0174250945d1aeb9bf55da94f58","author":"matemolnar8","timestamp":1776625714,"line":45,"text":"    let progress = flashlight_progress.clamp(0.0, 1.0) as CGFloat;"},{"sha":"ea7508c068a2a0174250945d1aeb9bf55da94f58","author":"matemolnar8","timestamp":1776625714,"line":46,"text":"    if progress > 0.0 {"},{"sha":"ea7508c068a2a0174250945d1aeb9bf55da94f58","author":"matemolnar8","timestamp":1776625714,"line":47,"text":"        let radius = flashlight_radius as CGFloat * (0.9 + 0.1 * progress);"},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":48,"text":"        let hole = CGRect::new("},{"sha":"5a57bb0b84dc7b7fb86b992cbd4f3e342713f1aa","author":"matemolnar8","timestamp":1776625267,"line":49,"text":"            CGPoint::new(pointer.x - radius, pointer.y - radius),"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":50,"text":"            CGSize::new(radius * 2.0, radius * 2.0),"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":51,"text":"        );"},{"sha":"48452567568162193746074a8f0e38e064f13c61","author":"matemolnar8","timestamp":1776622698,"line":52,"text":"        CGContext::save_g_state(c);"},{"sha":"ea7508c068a2a0174250945d1aeb9bf55da94f58","author":"matemolnar8","time